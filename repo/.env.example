# MergeStream local configuration. Copy to `.env` and edit for your machine.

# --- HTTP ---
MS_PORT=4000
MS_HOST=127.0.0.1
MS_CLIENT_ORIGIN=http://127.0.0.1:4000

# --- MongoDB ---
# For local dev, start a real MongoDB 6+ and point MS_MONGO_URL at it.
# The test suite uses mongodb-memory-server and ignores this value.
MS_MONGO_URL=mongodb://127.0.0.1:27017/mergestream

# --- Auth ---
# Generate with `node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"`
MS_JWT_ACCESS_SECRET=replace-me-with-a-64-byte-hex-value
MS_JWT_REFRESH_SECRET=replace-me-with-a-different-64-byte-hex-value
MS_ACCESS_TOKEN_TTL_SECONDS=900
MS_REFRESH_TOKEN_TTL_SECONDS=28800
MS_SESSION_TTL_SECONDS=28800
MS_BCRYPT_ROUNDS=12
MS_LOCKOUT_THRESHOLD=5
MS_LOCKOUT_WINDOW_SECONDS=900

# --- Rate limiting ---
MS_RATE_LIMIT_PER_MINUTE=60

# --- Pipeline engine ---
# Comma-separated list of filesystem roots that project repoPath values MUST resolve under.
# Example (Windows): C:\Users\you\mergestream\repos
# Example (POSIX):   /var/mergestream/repos
MS_ALLOWED_REPO_ROOTS=./fixtures/repos
# Root directory where ephemeral merge workspaces are created. MUST be different from repo roots.
MS_WORKSPACE_ROOT=./.tmp/workspaces
# Maximum duration (seconds) for a single shell test run before forced termination.
MS_TEST_TIMEOUT_SECONDS=600

# --- Queue ---
MS_MAX_CONCURRENT_RUNS=4
MS_MAX_QUEUED_RUNS=50

# --- Retention ---
MS_RUNS_RETENTION_PER_PROJECT=500
MS_NOTIFICATIONS_RETENTION_PER_USER=200
MS_AUDIT_SEARCH_LIMIT=1000
MS_HISTORY_DEFAULT_LIMIT=50

# --- Observability ---
MS_LOG_LEVEL=info

# --- Seed (dev only) ---
# Usernames are stable across reseeds.
MS_SEED_ADMIN_USERNAME=admin
MS_SEED_MAINTAINER_USERNAME=maintainer
MS_SEED_DEVELOPER_USERNAME=developer
# When set, the seed script uses these passwords AS-IS and skips the
# "must change password" flag. When unset (production), random temp
# passwords are generated and printed once on stdout.
MS_SEED_ADMIN_PASSWORD=AdminPass1!
MS_SEED_MAINTAINER_PASSWORD=MaintainerPass1!
MS_SEED_DEVELOPER_PASSWORD=DeveloperPass1!
