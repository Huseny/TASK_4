{
  "name": "mergestream",
  "version": "1.0.0",
  "private": true,
  "description": "MergeStream Continuous Delivery Pipeline Engine — offline-first local CD for small teams.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "app/server",
    "app/client"
  ],
  "scripts": {
    "start": "npm run build:client && npm -w app/server run start",
    "dev": "run-p dev:server dev:client",
    "dev:server": "npm -w app/server run dev",
    "dev:client": "npm -w app/client run dev",
    "build": "npm run build:server && npm run build:client",
    "build:server": "npm -w app/server run build",
    "build:client": "npm -w app/client run build",
    "lint": "npm -w app/server run lint && npm -w app/client run lint",
    "test": "npm run test:server && npm run test:client",
    "test:server": "npm -w app/server run test",
    "test:unit": "npm -w app/server run test:unit",
    "test:integration": "npm -w app/server run test:integration",
    "test:contract": "npm -w app/server run test:contract",
    "test:client": "npm -w app/client run test",
    "db:seed": "npm -w app/server run seed",
    "repos:init": "npm -w app/server run repos:init",
    "prune": "npm -w app/server run prune"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "typescript": "^5.4.5"
  }
}
